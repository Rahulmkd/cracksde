{
  "name": "starter-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npx concurrently --kill-others \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "db:studio": "npm run db:studio --workspace=apps/api",
    "db:reset": "npm run db:reset --workspace=apps/api"
  },
  "devDependencies": {
    "@prisma/client": "^7.10.0",
    "concurrently": "^9.1.0",
    "defu": "^6.1.7",
    "postcss": "^8.4.49",
    "prisma": "^8.0.0-rc.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.16"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "confbox": "^0.1.8",
    "effect": "^3.22.2"
  }
}
