# =====================================================================
# RENDER (Backend Web Service) Environment Variables
# =====================================================================
# Neon PostgreSQL connection string (pooled or standard with sslmode=require)
DATABASE_URL=postgresql://user:password@ep-divine-mode-a1fzigot.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Node runtime environment (production on Render)
NODE_ENV=production

# Render automatically sets PORT (or defaults to 5001)
PORT=5001

# Better Auth Secret (generate a secure random 32+ character string, e.g. using `openssl rand -hex 32`)
BETTER_AUTH_SECRET=generate-a-secure-random-secret-key-32-chars-min

# Public URL of your deployed Render backend (no trailing slash)
BETTER_AUTH_URL=https://your-api-service.onrender.com

# Allowed Frontend Origins (Comma-separated for multiple domains / preview URLs)
# Example: https://cracksde.vercel.app,https://www.cracksde.com,http://localhost:3000
CORS_ORIGIN=https://your-frontend-app.vercel.app


# =====================================================================
# VERCEL (Frontend Next.js App) Environment Variables
# =====================================================================
# Public URL of the deployed Render backend API
NEXT_PUBLIC_API_URL=https://your-api-service.onrender.com

# Optional server-side API URL for Next.js rewrites/SSR proxy
API_URL=https://your-api-service.onrender.com

# Node runtime environment
NODE_ENV=production


# =====================================================================
# LOCAL DEVELOPMENT (.env in root or apps/api)
# =====================================================================
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cracksde_db
# BETTER_AUTH_SECRET=development-secret-key-min-32-characters-long
# BETTER_AUTH_URL=http://localhost:5001
# PORT=5001
# NODE_ENV=development
# CORS_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:5001
